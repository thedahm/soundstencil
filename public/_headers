# Cloudflare static-assets headers. Vite copies public/ into dist/ verbatim.
# Nothing loads from another origin. blob: covers decoded media and generated
# downloads; 'wasm-unsafe-eval' covers WebAssembly. The pinned ffmpeg core URL
# is added here by the ffmpeg fallback slice (ADR-0001).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; media-src 'self' blob:; img-src 'self' blob:; connect-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
